# PostgreSQL connection used by Prisma. Never commit a real credential.
DATABASE_URL="postgresql://postgres:change-me@localhost:5432/jua_wayfinding?schema=public"

# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-value"
AUTH_URL="http://localhost:3000"

# Required only when running the demo seed. Use at least 12 characters.
SEED_ADMIN_PASSWORD="replace-for-local-demo-only"

# Future production image storage adapter.
IMAGE_STORAGE_PROVIDER="unconfigured"
IMAGE_STORAGE_BUCKET=""
IMAGE_STORAGE_PUBLIC_BASE_URL=""
